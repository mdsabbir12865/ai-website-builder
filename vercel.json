{
  "rewrites": [
    {
      "source": "/api/github/:action",
      "destination": "/api/github?action=:action"
    },
    {
      "source": "/api/vercel/:action",
      "destination": "/api/vercel?action=:action"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
